bool is_prime[1000001]; // all initialized as false
void sieve(){
	int maxN = 1000000;
	is_prime[0]= is_prime[1]=true; // false==prime, true==not prime
	for(int i=2;i*i<=maxN;i++){
		if(!is_prime[i]){
			for(int j=i*i;j<=maxN;j+=i)is_prime[j]=true;
		}
	}
}
