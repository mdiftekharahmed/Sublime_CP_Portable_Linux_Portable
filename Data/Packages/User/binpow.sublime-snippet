	<content><![CDATA[
ll bin_pow(ll base, ll power){
	ll res =1;
	while(power>0){
		if(power%2){
			res*=base;
			power--;
		}
		else{
			base = base * base;
			power /=2;
		}
	}

	return res;
}

]]></content>
